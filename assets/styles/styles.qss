QMainWindow, QWidget {
    background-color: #708090;
    color: #000000;
    font-family: "Segoe UI", sans-serif;
    font-size: 15px;
}

QLabel { font-family: "Segoe UI", sans-serif; font-size: 14px; }

QPushButton#answerBtn {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 5px;
    min-height: 40px;
    min-width: 80px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#answerBtn:hover {
    background-color: #e0e0e0;
}

QPushButton#answerBtn:pressed {
    background-color: #d0d0d0;
}

QPushButton#answerBtn:disabled {
    background-color: #f8f8f8;
    color: #aaa;
}

QPushButton#answerBtn[result="correct"]:!disabled {
    background-color: #4CAF50;
    color: white;
    border: 2px solid #45a049;
}

QPushButton#answerBtn[result="wrong"] {
    background-color: #e53935;
    color: white;
    border: 2px solid #c62828;
}

QPushButton#answerBtn[selected="true"] {
    background-color: #1565C0;
    color: white;
}

QPushButton#exerciseBtn {
    background-color: #2d2d2d;
    color: white;
    border-radius: 8px;
    font-size: 14px;
    padding: 8px 16px;
    min-width: 300px;
    min-height: 40px;
}

QPushButton#exerciseBtn:hover {
    background-color: #3d3d3d;
}

QPushButton#startBtn,
QPushButton#stopBtn,
QPushButton#replayBtn {
    background-color: #C0C0C0;
    color: #000000;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 8px 24px;
}
QPushButton#startBtn:hover,
QPushButton#stopBtn:hover,
QPushButton#replayBtn:hover {
    background-color: #333;
    border-color: #666;
}
QPushButton#startBtn:pressed,
QPushButton#stopBtn:pressed  {
    background-color: #F5FFFA;
    border-color: #1565C0;
}
QPushButton#startBtn:disabled,
QPushButton#stopBtn:disabled,
QPushButton#replayBtn:disabled {
    color: #555;
    border-color: #555;
}

/* Назад — менее заметный */
QPushButton#backBtn {
    background-color: transparent;
    color: #000000;
    border: 1px solid #444;
    border-radius: 6px;
}
QPushButton#backBtn:hover {
    color: #ccc;
    border-color: #666;
}

/* Кнопка меню ☰ */
QPushButton#menuBtn {
    background-color: transparent;
    border: none;
    color: #aaa;
    font-size: 18px;
    padding: 4px 8px;
}
QPushButton#menuBtn:hover {
    color: white;
}

/* Правая панель — Difficulty/Mode */
QComboBox {
    background-color: #2a2a2a;
    color: #000000;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 140px;
}
QComboBox:hover {
    border-color: #666;
}
QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #e0e0e0;
    selection-background-color: #1565C0;
}

/* Меню */
QMenuBar {
    background-color: #1a1a1a;
    color: #aaa;
}
QMenuBar::item:selected {
    background-color: #2a2a2a;
    color: white;
}
QMenu {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #444;
}
QMenu::item:selected {
    background-color: #1565C0;
}
