/* === BASE === */
QMainWindow, QWidget {
    background-color: #f5f7fa;
    color: #222;
    font-family: "Segoe UI", sans-serif;
    font-size: 14px;
}

QLabel {
    font-family: "Segoe UI", sans-serif;
    color: #222;
    background: transparent;
    border: none;
}

/* === ANSWER BUTTONS === */
QPushButton#answerBtn {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 10px;
    padding: 10px;
    min-height: 42px;
    min-width: 90px;
    font-size: 13px;
}

/* hover только для активных */
QPushButton#answerBtn:hover:!disabled {
    background-color: #f0f4f8;
}

QPushButton#answerBtn:pressed:!disabled {
    background-color: #e2e8f0;
}

QPushButton#answerBtn:disabled {
    background-color: #f3f3f3;
    color: #a0a0a0;
    border: 1px solid #e0e0e0;
}

/* состояния */
QPushButton#answerBtn[result="correct"]:!disabled {
    background-color: #4CAF50;
    color: white;
    border: none;
}

QPushButton#answerBtn[result="wrong"]:!disabled {
    background-color: #e53935;
    color: white;
    border: none;
}

QPushButton#answerBtn[selected="true"]:!disabled {
    background-color: #3a86ff;
    color: white;
    border: none;
}

/* === EXERCISE BUTTON === */
QPushButton#exerciseBtn {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
    text-align: left;
}

QPushButton#exerciseBtn:hover:!disabled {
    background-color: #f7f9fc;
    border: 1px solid #3a86ff;
}

QPushButton#exerciseBtn:pressed:!disabled {
    background-color: #eef4ff;
}

QPushButton#exerciseBtn:disabled {
    background-color: #f3f3f3;
    color: #a0a0a0;
    border: 1px solid #e0e0e0;
}

/* === CONTROL BUTTONS === */
QPushButton#startBtn,
QPushButton#stopBtn,
QPushButton#replayBtn {
    background-color: #3a86ff;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
}

QPushButton#startBtn:hover:!disabled,
QPushButton#stopBtn:hover:!disabled,
QPushButton#replayBtn:hover:!disabled {
    background-color: #5aa0ff;
}

QPushButton#startBtn:pressed:!disabled,
QPushButton#stopBtn:pressed:!disabled {
    background-color: #2f6fd1;
}

/* disabled для control */
QPushButton#startBtn:disabled,
QPushButton#stopBtn:disabled,
QPushButton#replayBtn:disabled {
    background-color: #e5e5e5;
    color: #9e9e9e;
    border: 1px solid #d0d0d0;
}

/* === BACK BUTTON === */
QPushButton#backBtn {
    background-color: transparent;
    border: 1px solid #ccc;
    border-radius: 6px;
    color: #444;
}

QPushButton#backBtn:hover:!disabled {
    background-color: #f0f4f8;
}

QPushButton#backBtn:disabled {
    color: #aaa;
    border-color: #e0e0e0;
}

/* === MENU BUTTON === */
QPushButton#menuBtn {
    background-color: transparent;
    border: none;
    color: #666;
    font-size: 18px;
    padding: 4px 8px;
}

QPushButton#menuBtn:hover:!disabled {
    color: black;
}

/* === COMBOBOX === */
QComboBox {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #dcdcdc;
    border-radius: 6px;
    padding: 5px 10px;
    min-width: 140px;
}

QComboBox:hover {
    border-color: #bdbdbd;
}

QComboBox:disabled {
    background-color: #f3f3f3;
    color: #a0a0a0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #222;
    selection-background-color: #3a86ff;
    selection-color: white;
}

/* === MENU === */
QMenuBar {
    background-color: #ffffff;
    color: #444;
}

QMenuBar::item:selected {
    background-color: #f0f4f8;
}

QMenu {
    background-color: #ffffff;
    color: #222;
    border: 1px solid #dcdcdc;
}

QMenu::item:selected {
    background-color: #3a86ff;
    color: white;
}

QFrame {
    background-color: #ffffff;
    border: 1px solid #dcdcdc;
    border-radius: 12px;
    padding: 10px;
}

QLabel#descriptionLabel{
    font-size: 18px;
    font-weight: 600;
}

QPushButton#blockBtn {
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
}

QPushButton#blockBtn:hover {
    background-color: #f7f9fc;
    border: 1px solid #3a86ff;
}

QPushButton#blockBtn[active="true"] {
    background-color: #3a86ff;
    color: white;
}

QLabel#blockLabel{
    background-color: #3a86e8;
    font-size: 20px;
    font-weight: 600;
    color: white;
}

QPushButton#octBtn {
       border: 1px solid #aaa;
       border-radius: 14px;
       background: #f5f5f5;
       font-size: 18px;
       font-weight: bold;
}
QPushButton#octBtn:hover  { background: #e0e0e0; }
QPushButton#octBtn:pressed{ background: #ccc; }
QPushButton#octBtn:disabled{ color: #ccc; border-color: #ddd; }
